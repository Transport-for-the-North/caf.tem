
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TEM from Config File",
            "type": "python",
            "request": "launch",
            "module": "caf.tem",
            "args": [
                "C:/Users/Isaac.Scott/Documents/GitHub/caf.tem/examples/example_config.yml"
            ],
            "console": "integratedTerminal",
